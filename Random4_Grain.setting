    Height = Input { Expression = "SalmsRectangle.Height" },
    Solid = Input { Value = 0 },
    BorderWidth = Input { Value = 0.003 }
   },
   ViewInfo = OperatorInfo { Pos = { 330, -130 } }
  },
  SalmsWhite = Background {
   Inputs = {
    UseFrameFormatSettings = Input { Value = 1 },
    TopLeftRed = Input { Value = 1 },
    TopLeftGreen = Input { Value = 1 },
    TopLeftBlue = Input { Value = 1 },
    TopLeftAlpha = Input { Value = 1 },
    EffectMask = Input { SourceOp = "SalmsOutline", Source = "Mask" }
   },
   ViewInfo = OperatorInfo { Pos = { 495, -65 } }
