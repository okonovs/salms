    Width = Input { Expression = "0.18+0.40*((sin((floor((time-comp.RenderStart)/4)+17)*12.9898+1*78.233)*43758.5453)-floor((sin((floor((time-comp.RenderStart)/4)+17)*12.9898+1*78.233)*43758.5453)))" },
    Height = Input { Expression = "0.18+0.44*((sin((floor((time-comp.RenderStart)/4)+17)*12.9898+2*78.233)*43758.5453)-floor((sin((floor((time-comp.RenderStart)/4)+17)*12.9898+2*78.233)*43758.5453)))" },
    Solid = Input { Value = 1 }
   },
   ViewInfo = OperatorInfo { Pos = { 165, -65 } }
  },
  SalmsSharpWindow = Merge {
   Inputs = {
    Background = Input { SourceOp = "SalmsFilmGrain", Source = "Output" },
    Foreground = Input { SourceOp = "SalmsTimeline", Source = "Output" },
    EffectMask = Input { SourceOp = "SalmsRectangle", Source = "Mask" },
    PerformDepthMerge = Input { Value = 0 }
   },
   ViewInfo = OperatorInfo { Pos = { 330, 0 } }
  },
  SalmsOutline = RectangleMask {
